<% layout("/layouts/boilerplate") -%>

    <div class="d-flex justify-content-center">
        <div class="listing-single-card">
            <div class="d-flex flex-lg-row flex-column justify-content-start justify-content-lg-between gap-4 position-relative" id="show-hero-container" style="padding-top: 3rem;">
                <div class="single-card-img-overlay">
                    <a href="/listings" class="home-link nav-link d-flex justify-content-start align-items-center gap-1 mb-1 mt-4 position-absolute">
                        <i class="fa-solid fa-angle-left"></i>
                        <span>
                            <i>Back to home</i>
                        </span>
                    </a>
                    <img src="<%= listing.image.url %>" class="single-card-img-top" alt="listing-image">
                </div>
                <div class="d-block justify-content-between align-items-between mt-2">
                    <div class="d-flex justify-content-between" style="margin-bottom: 2rem; gap: 1.5rem;">
                        <div>
                            <h3 class="mb-0" style="color: #373032; font-weight: 700; max-width: 381px;"><%= listing.title %></h3>
                            <p class="card-text" style="font-size: 10px;"><i> Owned by @<%= listing.owner.username %></i></p>
                        </div>

                        <div> 
                            <% if (currUser && currUser._id.equals(listing.owner._id)) { %>
                                <div class="btns change-listing-btns">
                                    <a href="/listings/<%= listing._id %>/edit" class="btn edit-btn">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <div class="vr my-1"></div>

                                    <button type="button" class="btn del-btn" data-bs-toggle="modal" data-bs-target="#exampleModal">
                                        <i class="fa-regular fa-trash-can"></i>
                                    </button>

                                    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered ">
                                        <div class="modal-content mx-3 rounded-4">
                                            <div class="modal-header d-flex">
                                                <h4 class="modal-title flex-fill text-center" id="staticBackdropLabel" style="font-size: 1.2rem;">Delete Property</h4>
                                                <button type="button" class="btn-close" style="font-size: 10px;" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>

                                            <div class="modal-body fw-medium" style="padding-block: 2rem 3rem !important; text-align: center;">
                                                Are you sure you want to delete this property?
                                            </div>
                                            
                                            <div class="modal-footer border-0" style="box-shadow: 0px -4px 18px 2px rgba(128, 128, 128, 0.194);">
                                                <button type="button" class="btn px-2" id="cancelSearchButton" data-bs-dismiss="modal">Cancel</button>
                                                <form class="delete-form" method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                                                    <button class="btn modal-delete-btn">
                                                        Delete
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                    </div>
                                </div>
                            <% } %>
                        </div>

                    </div>
                    
                    <div class="d-flex flex-column" style="gap: 1.8rem;">
                        <div class="">
                            <p class="info-heading mb-0">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" transform="rotate(0 0 0)">
                                <path d="M5.25 19V4.25C5.25 3.42157 5.92157 2.75 6.75 2.75H17.25C18.0784 2.75 18.75 3.42157 18.75 4.25V16.75H7.5C6.25736 16.75 5.25 17.7574 5.25 19ZM5.25 19C5.25 20.2426 6.25736 21.25 7.5 21.25H18.75M17.25 21.25V16.75M8.25 5.75H15.75V9.75H8.25V5.75Z" stroke="#222222e8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                <span>

                                    About
                                </span>
                            </p>
                            <p class="card-text" id="description"><%= listing.description %></p>
                        </div>
                        
                        <div class="">

                            <p class="info-heading mb-0">
                                <svg width="14" height="14" viewBox="0 0 25 25" fill="none" xmlns="http://www.w3.org/2000/svg" transform="rotate(0 0 0)">
                                <path fill-rule="evenodd" clip-rule="evenodd" d="M13.2539 13.5379C15.8674 13.1731 17.8789 10.9289 17.8789 8.21484C17.8789 5.24631 15.4724 2.83984 12.5039 2.83984C9.53538 2.83984 7.12891 5.24631 7.12891 8.21484C7.12891 10.9289 9.14041 13.1731 11.7539 13.5379L11.7539 22.0898C11.7539 22.5041 12.0897 22.8398 12.5039 22.8398C12.9181 22.8398 13.2539 22.5041 13.2539 22.0898L13.2539 13.5379ZM8.62891 8.21484C8.62891 6.07474 10.3638 4.33984 12.5039 4.33984C14.644 4.33984 16.3789 6.07474 16.3789 8.21484C16.3789 10.3549 14.644 12.0898 12.5039 12.0898C10.3638 12.0898 8.62891 10.3549 8.62891 8.21484Z" fill="#222222e8"/>
                                </svg>
                                <span>

                                    City
                                </span>
                            </p>
                            <p class="card-text">
                                <span>
                                    <%= listing.location %>,
                                </span>
                                <span>
                                    <%= listing.country %>
                                </span>
                            </p>
                        </div>

                        <div class="d-flex justify-content-evenly justify-content-lg-between mb-4 mb-lg-3  border-top border-bottom border-lg-0 py-lg-2 py-4">
                            
                            <div class="info-block">
                                
                                <p class="info-heading mb-0">
                                    <i class="fa-regular fa-star"></i> 
                                    <span>
                                        Avg Rating
                                    </span>
                                </p>
                                <p class="card-text"><%= avg_rating %></p>
                            </div>
                            <div class="vr"></div>
                            <div class="info-block">

                                <p class="info-heading mb-0">
                                        <svg width="15" height="15" viewBox="0 0 25 24"
                                        strokeWidth="4" 
                                        fill="none" xmlns="http://www.w3.org/2000/svg" transform="rotate(0 0 0)">
                                        <path d="M15.3289 11.4955C14.4941 11.4955 13.724 11.2188 13.1051 10.7522C13.3972 10.3301 13.6284 9.86262 13.786 9.36254C14.1827 9.7539 14.7276 9.99545 15.3289 9.99545C16.5422 9.99545 17.5258 9.01185 17.5258 7.79851C17.5258 6.58517 16.5422 5.60156 15.3289 5.60156C14.7276 5.60156 14.1827 5.84312 13.786 6.23449C13.6284 5.73441 13.3972 5.26698 13.1051 4.84488C13.7239 4.37824 14.4941 4.10156 15.3289 4.10156C17.3706 4.10156 19.0258 5.75674 19.0258 7.79851C19.0258 9.84027 17.3706 11.4955 15.3289 11.4955Z" fill="#222222e8" stroke-width="2"/>
                                        <path d="M14.7723 13.1891C15.0227 13.437 15.2464 13.6945 15.4463 13.9566C16.7954 13.9826 17.7641 14.3143 18.4675 14.7651C19.2032 15.2366 19.6941 15.8677 20.0242 16.5168C20.3563 17.1698 20.5204 17.8318 20.6002 18.337C20.6398 18.5878 20.6579 18.795 20.6661 18.9365C20.6702 19.0071 20.6717 19.061 20.6724 19.0952L20.6726 19.1161L20.6727 19.1313L20.6727 19.1363L21.4197 19.1486C20.6793 19.1358 20.6728 19.136 20.6727 19.1363L20.6727 19.1376C20.6666 19.5509 20.9961 19.8914 21.4096 19.8985C21.8237 19.9057 22.1653 19.5758 22.1725 19.1617L21.4284 19.1488C22.1725 19.1617 22.1725 19.1621 22.1725 19.1617L22.1725 19.1599L22.1726 19.1575L22.1726 19.1511L22.1727 19.1319C22.1727 19.1163 22.1726 19.0951 22.1721 19.0686C22.1712 19.0158 22.1689 18.9419 22.1636 18.85C22.153 18.6665 22.1303 18.4094 22.0819 18.1029C21.9856 17.4936 21.7848 16.6697 21.3612 15.8368C20.9357 15 20.2801 14.1451 19.2768 13.5022C18.2708 12.8574 16.9604 12.4549 15.274 12.4549C14.8284 12.4549 14.4092 12.483 14.0148 12.5362C14.2852 12.7384 14.5376 12.9566 14.7723 13.1891Z" fill="#222222e8" stroke-width="2"/>
                                        <path fill-rule="evenodd" clip-rule="evenodd" d="M5.13173 7.79855C5.13173 5.75678 6.7869 4.1016 8.82867 4.1016C10.8704 4.1016 12.5256 5.75678 12.5256 7.79855C12.5256 9.84031 10.8704 11.4955 8.82867 11.4955C6.7869 11.4955 5.13173 9.84031 5.13173 7.79855ZM8.82867 5.6016C7.61533 5.6016 6.63173 6.58521 6.63173 7.79855C6.63173 9.01189 7.61533 9.99549 8.82867 9.99549C10.042 9.99549 11.0256 9.01189 11.0256 7.79855C11.0256 6.58521 10.042 5.6016 8.82867 5.6016Z" fill="#222222e8" stroke-width="2"/>
                                        <path d="M3.37502 19.1374C3.38126 19.5507 3.0517 19.8914 2.63812 19.8986C2.22397 19.9058 1.88241 19.5759 1.87522 19.1617L2.62511 19.1487C1.87522 19.1617 1.87523 19.1621 1.87522 19.1617L1.87519 19.1599L1.87516 19.1575L1.87509 19.1511L1.875 19.1319C1.87499 19.1163 1.87512 19.0951 1.87559 19.0687C1.87653 19.0158 1.87882 18.942 1.88413 18.85C1.89474 18.6665 1.91745 18.4094 1.96585 18.103C2.0621 17.4936 2.26292 16.6697 2.68648 15.8368C3.11206 15 3.76758 14.1452 4.77087 13.5022C5.77688 12.8575 7.08727 12.455 8.77376 12.455C10.4602 12.455 11.7706 12.8575 12.7767 13.5022C13.7799 14.1452 14.4355 15 14.861 15.8368C15.2846 16.6697 15.4854 17.4936 15.5817 18.103C15.6301 18.4094 15.6528 18.6665 15.6634 18.85C15.6687 18.942 15.671 19.0158 15.6719 19.0687C15.6724 19.0951 15.6725 19.1163 15.6725 19.1319L15.6724 19.1511L15.6724 19.1575L15.6723 19.1599C15.6723 19.1603 15.6723 19.1617 14.9282 19.1488L15.6723 19.1617C15.6651 19.5759 15.3235 19.9058 14.9094 19.8986C14.4959 19.8914 14.1664 19.5509 14.1725 19.1376L14.1725 19.1364C14.1726 19.1361 14.1791 19.1358 14.9199 19.1487L14.1725 19.1364L14.1725 19.1314L14.1724 19.1161L14.1722 19.0952C14.1716 19.061 14.17 19.0072 14.1659 18.9366C14.1577 18.7951 14.1396 18.5878 14.1 18.337C14.0202 17.8319 13.8561 17.1699 13.524 16.5168C13.1939 15.8677 12.703 15.2366 11.9673 14.7651C11.2343 14.2954 10.2132 13.955 8.77376 13.955C7.33434 13.955 6.31319 14.2954 5.58022 14.7651C4.84453 15.2366 4.35363 15.8677 4.02351 16.5168C3.6914 17.1699 3.52727 17.8319 3.44749 18.337C3.40787 18.5878 3.38981 18.7951 3.38163 18.9366C3.37756 19.0072 3.37596 19.061 3.37536 19.0952C3.37505 19.1123 3.375 19.1245 3.375 19.1314L3.37502 19.1374Z" fill="#222222e8" stroke-width="2"/>
                                        </svg>
                                    <span>

                                        Reviews
                                    </span>
                                </p>
                                <p class="card-text">
                                    <%= listing.reviews.length %>
                                </p>
                            </div>
                            <div class="vr"></div>
                            <div class="info-block">
                                <p class="info-heading mb-0">
                                    <svg width="14" height="14" viewBox="0 0 25 24" fill="none" xmlns="http://www.w3.org/2000/svg" transform="rotate(0 0 0)">
                                    <path d="M14 9.85184C14 9.12691 13.4123 8.53924 12.6874 8.53924H12C11.1716 8.53924 10.5 9.21082 10.5 10.0392V10.3043C10.5 10.9296 10.8878 11.4892 11.4733 11.7088L13.0267 12.2914C13.6122 12.5109 14 13.0706 14 13.6959V13.9609C14 14.7894 13.3284 15.4609 12.5 15.4609H11.8126C11.0877 15.4609 10.5 14.8733 10.5 14.1483M12.25 15.4609V16.625M12.25 7.375V8.53924M3 12C3 17.1086 7.14137 21.25 12.25 21.25C17.3586 21.25 21.5 17.1086 21.5 12C21.5 6.89137 17.3586 2.75 12.25 2.75C7.14137 2.75 3 6.89137 3 12Z" stroke="#222222e8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                    <span>

                                    Extra charges
                                    </span>                                
                                </p>
                                <p class="card-text">None</p>
                            </div>
                        </div>
                        
                    </div>

                    <hr class="d-none my-3">

                    <div class="d-flex justify-content-start gap-3">
                        
                        <% if(currUser && !(listing.owner.equals(currUser._id)) ) { %>    
                            <% const bookedIds = listing.bookedUsers.map(id => id.toString()); %>
                            <% const isBooked = bookedIds.includes(currUser._id.toString()); %>
                            <% const isSavedByUser = listing.isSaved.some(id => id.equals(currUser._id)); %>
                            
                            <button 
                                class="btn book-btn btn-secondary d-flex justify-content-center align-items-center gap-2 py-1"
                                style="height: 50px; flex: 1; border-radius: 12px;"
                                data-bs-toggle="modal" 
                                data-bs-target="<%= isBooked ? '#cancelModal' : '#bookingModal' %>"
                            >
                                <p class="card-text mb-0">
                                    <% if(isBooked) { %>
                                        Cancel your booking
                                    <% } else { %>
                                        Book at &#8377; <%= listing.price.toLocaleString('en-IN') %> / night
                                        <i class="tax-info">&#8377; <%= listing.price + (18*listing.price/100)  %> (after tax)</i>
                                    <% } %>
                                </p>
                                <i class="fa-solid fa-arrow-right-long"></i>
                            </button>

                            <div class="modal fade" id="bookingModal" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content overflow-y">
                                        <form id="bookingForm" class="needs-validation" action="/" method="POST" novalidate>
                                            
                                            <div class="modal-header">
                                                <h4 class="modal-title text-center w-100 fw-bold" id="exampleModalLabel" style="font-size: 1.2rem;">Confirm booking</h4>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="font-size: 11px; width: 13px; height: 13px;"></button>
                                            </div>

                                            <div class="modal-body p-4 pb-5">

                                                <div class="mb-3">
                                                    <label for="name" class="form-label">Name</label>
                                                    <input type="text" id="name" class="form-control" placeholder="Enter your name" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label for="email" class="form-label">E-mail</label>
                                                    <input type="text" id="email" class="form-control" placeholder="Enter your email" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label for="phone-no" class="form-label">Phone number</label>
                                                    <input type="tel" id="phone-no" class="form-control" inputmode="numeric" maxlength="10"  placeholder="Enter phone number" required>
                                                </div>

                                                <div class="d-flex justify-content-between gap-3">
                                                    <div class="mb-3 w-50">
                                                        <label for="checkin" class="form-label">Check-in Date</label>
                                                        <input type="text" id="book-checkin" class="form-control" name="checkin" placeholder="select check-in" required>
                                                    </div>
                                                    <div class="mb-3 w-50">
                                                        <label for="checkout" class="form-label">Check-out Date</label>
                                                        <input type="text" id="book-checkout" class="form-control" name="checkout" placeholder="select check-out" required>
                                                    </div>
                                                </div>
                                                
                                            </div>

                                            <div class="modal-footer border-0" style="box-shadow: 0px -4px 18px 2px rgba(128, 128, 128, 0.194);">
                                                <button type="button" class="btn btn-outline-secondary rounded-5 px-4" style="font-size: 12px;" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-dark rounded-5 px-4" style="font-size: 12px;">Confirm & Pay</button>
                                            </div>

                                        </form>
                                    </div>
                                </div>
                            </div>

                            <div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content overflow-y" style="margin-inline: 1rem; border-radius: 22px;">
                                        <div class="modal-header">
                                            <h4 class="modal-title text-center w-100 fw-bold" id="exampleModalLabel" style="font-size: 1.2rem;">Cancel booking</h4>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="font-size: 11px; width: 13px; height: 13px;"></button>
                                        </div>

                                        <div class="modal-body p-4 pb-5 fw-medium" style="font-size: 13px; padding-bottom: 1rem !important;">
                                            <p class="text-center">Are you sure you want to cancel your booking for this listing?</p>
                                        </div>

                                        <div class="modal-footer border-0" style="box-shadow: 0px -4px 18px 2px rgba(128, 128, 128, 0.194);">
                                            <button type="button" class="btn btn-outline-secondary rounded-5 px-4 fw-medium" style="font-size: 12px;" data-bs-dismiss="modal">No</button>
                                            <form method="POST" action="/payments/<%= listing._id %>/create-refund">
                                                <button type="submit" class="btn btn-dark rounded-5 px-4 fw-medium" style="font-size: 12px;">Yes, Cancel</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <button 
                                class="btn d-flex justify-content-center align-items-center gap-2 py-1 <%= isSavedByUser ? 'save-btn-filled' : 'save-btn-outline' %>" 
                                onclick="toggleSave(event, '<%= listing._id %>')"
                            >
                                <i class="fa-solid fa-bookmark" style="<%= isSavedByUser ? 'font-size: 13px;' : 'display:none;' %>"></i>
                                <i class="fa-regular fa-bookmark" style="<%= isSavedByUser ? 'display:none;' : 'font-size: 13px;' %>"></i>
                            </button>

                        <% } else if(currUser && listing.owner.equals(currUser._id)) { %>
                            
                            <button 
                                class="btn book-btn btn-secondary d-flex justify-content-center align-items-center gap-2 py-1"
                                style="height: 50px; flex: 1; border-radius: 12px;"
                                data-bs-toggle="modal" 
                                data-bs-target="#analyticsModal"
                            >
                                <p class="card-text mb-0">
                                    See your property analysis
                                </p>
                                <i class="fa-solid fa-chart-pie" style="font-size: 13px;"></i>
                            </button>

                            <div class="modal fade" id="analyticsModal" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content overflow-y" style="margin-inline: 1rem !important; border-radius: 1rem !important;">
                                            
                                        <div class="modal-header">
                                            <h4 class="modal-title text-center w-100 fw-bold" id="exampleModalLabel" style="font-size: 1.2rem;">Property Analysis</h4>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="font-size: 11px; width: 13px; height: 13px;"></button>
                                        </div>

                                        <div class="modal-body row g-3 p-4 pb-5" style="padding-bottom: 1.5rem !important;">

                                            <div class="col-6 mb-3">
                                                <h4>Reviews</h4>

                                                <div class="d-flex">
                                                    <%= listing.reviews.length %>
                                                </div>
                                            </div>
                                            <div class="col-6 mb-3">
                                                <h4>Bookings</h4>

                                                <div class="d-flex">
                                                    <%= listing.bookedUsers.length %>
                                                </div>
                                            </div>
                                            <div class="col-6 mb-3">
                                                <h4>Saved</h4>

                                                <div class="d-flex">
                                                    <%= listing.isSaved.length %>
                                                </div>
                                            </div>
                                            
                                        </div>

                                        <div class="modal-footer border-0" style="box-shadow: 0px -4px 18px 2px rgba(128, 128, 128, 0.194);">
                                            <button type="button" class="btn btn-outline-secondary rounded-5 px-4" style="font-size: 12px;" data-bs-dismiss="modal">Close</button>
                                        </div>

                                    </div>
                                </div>
                            </div>

                        <% } else { %>

                            <a 
                                href="/login"
                                class="btn book-btn btn-secondary d-flex justify-content-center align-items-center gap-2 py-1"
                                style="height: 50px; flex: 1; border-radius: 12px;"   
                            >
                                <p class="card-text mb-0">
                                    Book at &#8377; <%= listing.price.toLocaleString('en-IN') %> / night
                                    <i class="tax-info">&#8377; <%= listing.price + (18*listing.price/100)  %> (after tax)</i>
                                </p>
                                <i class="fa-solid fa-arrow-right-long"></i>
                            </a>
                            
                            <button 
                                class="btn save-btn-outline d-flex justify-content-center align-items-center gap-2 py-1" 
                                onclick="redirectToLogin(event)"
                            >
                                <i class="fa-regular fa-bookmark" style="font-size: 13px;"></i>
                            </button>
                        <% } %>


                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="w-100">
        <hr class="show-hr">
    </div>

    <div>
        <div class="map-container d-flex flex-lg-row flex-column justify-content-start justify-content-lg-between position-relative">
            <h4 class="position-absolute" style="color: #373032; font-weight: 700; top: -10px; left: 0">Map Location</h4>
            
                <div id="map">
                </div>

                <div class="card maps-card">
                    <h4 style="color: #373032; font-size: 1.2rem; font-weight: 700; margin-bottom: 0.7rem;">Where you'll be</h4>
                    <div class="card-body d-flex flex-column gap-3">
    
                        <div class="d-flex justify-content-start align-items-top gap-2 fw-medium item">
                            
                            <svg style="margin-top: 3px;" width="20" height="20" viewBox="0 0 25 25" fill="none" xmlns="http://www.w3.org/2000/svg" transform="rotate(0 0 0)">
