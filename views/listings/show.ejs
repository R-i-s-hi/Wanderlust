    <div class="reviews-section" style="color: #212529ed; font-weight: 700;">
        <% if (currUser) { %>
            <div class="w-100">
                <hr class="show-hr">
            </div>

            <h4 style="color: #373032; font-weight: 700;">Leave a Review</h4>
            
            <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation mb-3">
                <div class="mb-3 mt-4">
                    <label for="rating" class="form-label">Rating</label>
                    <fieldset class="starability-growRotate"> 
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>
                <div class="mb-3">
                    <label for="comment" class="form-label">Comment</label>
                    <textarea style="max-height: 210px; border-radius: 10px;font-size: 13.5px; font-weight: 500; color: #212529e9;" name="review[comment]" id="comment" cols="30" rows="4" class="form-control" required></textarea>
                    <div class="invalid-feedback">Please add some comments!</div>
                </div>
                <button class="btn btn-dark mb-3 px-4 rounded-pill fw-semibold" style="font-size: 13px;">Submit</button>
            </form>

        <% } %>

        <hr class="show-hr">

        <% if (listing.reviews.length !== 0) { %>
            
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 style="color: #373032; font-weight: 700; margin-block: 1.6rem;">
                    All Reviews (<%= listing.reviews.length %>)
                </h4>
                <div class="d-flex justify-content-center align-items-center gap-2">
                    <button id="prevBtn" class="btn btn-dark btn-sm">
                        <i class="fa-solid fa-angle-left"></i>
                    </button>
                    <button id="nextBtn" class="btn btn-dark btn-sm">
                        <i class="fa-solid fa-angle-right"></i>
                    </button>
                </div>
            </div>

            <div id="reviewStrip" class="d-flex justify-content-start align-items-center gap-md-3 gap-2">
                <% listing.reviews.forEach((review, index) => { %>
                    <div class="card review-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                            <h5 class="card-title">
                                <b>@<%= review.author.username %></b>
                            </h5>
                            <% if (currUser && currUser._id.equals(review.author._id)) { %>
                                <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                                <button class="btn btn-dark btn-sm del-btn">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                                </form>
                            <% } %>
                            </div>
                            <div class="p-2">
                                <p class="card-text mb-2"><%= review.comment %></p>
                                <p class="starability-result card-text mb-0" data-rating="<%= review.rating %>"></p>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>

        <% } %>
        <% if (listing.reviews.length === 0) { %>
            <div class="no-review d-flex flex-column justify-content-center mb-5">
                <h4 class="mb-3" style="color: #fe424d; font-weight: 700; text-align: center;">No Reviews!</h4>
                <img src="/images/no-reviews.svg" alt="">
            </div>
        <% } %>

    </div>


    <script>  
        const lon = "<%- JSON.stringify(listing.geometry.coordinates[1]) %>";
        const lat = "<%- JSON.stringify(listing.geometry.coordinates[0]) %>";
        const locationData = "<%- listing.location %>";
        const countryData = "<%- listing.country %>";

        let taxSwitch = document.getElementById("flexSwitchCheckDefault");
        if(taxSwitch) {
            taxSwitch.addEventListener("click", () => {
                let taxInfo =  document.getElementsByClassName("tax-info");
                for (info of taxInfo) {
                    if (info.style.display != "inline") {
                        info.style.display = "inline";
                    } else {
                        info.style.display = "none";
                    }
                }
            })
        };

        const strip = document.getElementById('reviewStrip');
        const cards = strip.querySelectorAll('.review-card');
        let activeIndex = 0;

        function scrollToCard(index) {
        if (index < 0 || index >= cards.length) return;
        activeIndex = index;
        cards[activeIndex].scrollIntoView({ behavior: 'smooth', inline: 'center' });
        }

        document.getElementById('prevBtn').addEventListener('click', () => {
        scrollToCard(activeIndex - 1);
        });

        document.getElementById('nextBtn').addEventListener('click', () => {
        scrollToCard(activeIndex + 1);
        });


        function redirectToLogin(e) {
            e.preventDefault();
            e.stopPropagation();
            window.location.href = "/login";
        }

        function toggleSave(e, listingId) {
            const btn = e.currentTarget;
            const solidIcon = btn.querySelector(".fa-solid");
            const regularIcon = btn.querySelector(".fa-regular");

            fetch(`/listings/${listingId}/toggle-save`, { method: "POST" })
                .then(res => res.json())
                .then(data => {
                    if (data.isSaved) {
                        btn.classList.remove("save-btn-outline");
                        btn.classList.add("save-btn-filled");

                        solidIcon.style.display = "inline";
                        regularIcon.style.display = "none";
                    } else {
                        btn.classList.remove("save-btn-filled");
                        btn.classList.add("save-btn-outline");

                        solidIcon.style.display = "none";
                        regularIcon.style.display = "inline";
                    }
                })
                .catch(err => console.error("Error toggling save:", err));
        };

        document.addEventListener("DOMContentLoaded", function() {
            flatpickr("#book-checkin", {
                dateFormat: "Y-m-d",
                minDate: "today",
            });

            flatpickr("#book-checkout", {
                dateFormat: "Y-m-d",
                minDate: "today",
            });
        });

        async function placeOrder(id) {
            try {
                const bookingData = {
                    name: document.getElementById("name").value,
                    email: document.getElementById("email").value,
                    phone: document.getElementById("phone-no").value,
                    checkin: document.getElementById("book-checkin").value,
                    checkout: document.getElementById("book-checkout").value
                };

                const response = await fetch(`/payments/${id}/create-order`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(bookingData)
                });
                const order = await response.json();
                
                if(order.status == "created") {
                    const options = {
    
                        key: "<%= razorpayKey %>",
                        amount: order.amount,
                        currency: order.currency,
                        name: "WanderLust",
                        description: "Booking Payment",
                        order_id: order.id,
                        handler: 
                        async function (response) {
    
                            const verifyResponse = await fetch(`/payments/${id}/verify-payment`, {
                                method: "POST",
                                headers: {
                                    "Content-Type": "application/json"
                                },
                                body: JSON.stringify({
                                    razorpay_payment_id: response.razorpay_payment_id,
                                    razorpay_order_id: response.razorpay_order_id,
                                    razorpay_signature: response.razorpay_signature
                                })
                            });
                            const result = await verifyResponse.json();
                        },
                        modal: {
                            ondismiss: 
                            async function () {
                                await fetch("/payments/mark-failed", {
                                    method: "POST",
                                    headers: { "Content-Type": "application/json" },
                                    body: JSON.stringify({ order_id: order.id })
                                });
                            }
                        }
                    };
                    const razorpay = new Razorpay(options);
                    razorpay.open();
                }

            } catch (err) {
                console.log(err);
            }

        }

        document.getElementById("bookingForm").addEventListener("submit", async function(e) {
            e.preventDefault();

            if (!bookingForm.checkValidity()) {
                e.stopPropagation();
                bookingForm.classList.add("was-validated");
                return;
            }

            await placeOrder("<%= listing._id %>");

            bookingForm.reset();
            bookingForm.classList.remove("was-validated");
            
            var modal = bootstrap.Modal.getInstance(document.getElementById("bookingModal"));
            modal.hide();


        });

    </script>