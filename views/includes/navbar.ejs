<script>
  document.addEventListener("DOMContentLoaded", function() {
    flatpickr("#nav-checkin", { dateFormat: "Y-m-d", minDate: "today", closeOnSelect: false });
    flatpickr("#nav-checkout", { dateFormat: "Y-m-d", minDate: new Date().fp_incr(1), closeOnSelect: false });
  });

  document.querySelectorAll(".list-group-item").forEach(item => {
    const input = item.querySelector(".travelerCount");
    const dec = item.querySelector(".decrement");
    const inc = item.querySelector(".increment");
    const MAX = parseInt(input.max, 10);
    const MIN = parseInt(input.min, 10);

    inc.addEventListener("click", () => {
      let value = parseInt(input.value, 10);
      if (value < MAX) input.value = value + 1;
    });

    dec.addEventListener("click", () => {
      let value = parseInt(input.value, 10);
      if (value > MIN) input.value = value - 1;
    });
  });

</script>