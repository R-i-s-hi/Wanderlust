<% if (success && success.length) { %>
    <div class="alert alert-success alert-dismissible fade show d-flex justify-content-between align-items-center gap-4" role="alert">
        <div class="d-flex justify-content-start align-items-center gap-2">
            <i class="fa-regular fa-circle-check"></i>
            <span><%= success %></span>
        </div>
        <button  type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>
<% if (error && error.length) { %>
    <div class="alert alert-danger alert-dismissible fade show d-flex justify-content-between align-items-center gap-4"  role="alert">
        <div class="d-flex justify-content-start align-items-center gap-2">
            <i class="fa-regular fa-circle-xmark"></i>
            <span><%= error %></span>
        </div>
        <button  type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>